generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  COORDINATOR
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(TEACHER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Teacher {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())

  subjects Subject[]
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())

  subjects Subject[]
}

model Subject {
  id           Int        @id @default(autoincrement())
  code         String     @unique
  name         String
  semester     Int
  academicYear String

  teacherId    Int
  departmentId Int

  teacher      Teacher    @relation(fields: [teacherId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])

  cos          CourseOutcome[]
  coPoMappings CoPoMapping[]
  studentMarks StudentMark[]
}

model CourseOutcome {
  id        Int    @id @default(autoincrement())
  code      String
  statement String

  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id])

  coPoMappings CoPoMapping[]
  studentMarks StudentMark[]

  @@unique([subjectId, code])
}

model ProgramOutcome {
  id        Int    @id @default(autoincrement())
  code      String @unique
  statement String

  coPoMappings CoPoMapping[]
}

model ProgramSpecificOutcome {
  id        Int    @id @default(autoincrement())
  code      String @unique
  statement String

  coPoMappings CoPoMapping[]
}

model CoPoMapping {
  id Int @id @default(autoincrement())

  coId Int
  poId Int?
  psoId Int?

  level Float

  subject   Subject      @relation(fields: [subjectId], references: [id])
  subjectId Int

  co CourseOutcome @relation(fields: [coId], references: [id])
  po ProgramOutcome? @relation(fields: [poId], references: [id])
  pso ProgramSpecificOutcome? @relation(fields: [psoId], references: [id])

  @@index([coId])
  @@index([poId])
  @@index([psoId])
}

model StudentMark {
  id Int @id @default(autoincrement())

  studentRollNo String
  marks         Float

  subjectId Int
  coId      Int

  subject Subject      @relation(fields: [subjectId], references: [id])
  co      CourseOutcome @relation(fields: [coId], references: [id])

  @@index([studentRollNo])
  @@index([subjectId])
  @@index([coId])
}